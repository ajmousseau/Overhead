7%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:16.063397015842106%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:6.570027539698712%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:34.10707382111161%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:65.49593579704556%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:71.76065623468118%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:65.3507532630023%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:68.72778843147796%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:71.51823792485942%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:49.976417557124684%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:15.393188297485873%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:6.860997367482559%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:34.99308194714675%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:65.97477613750105%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:71.63738287245765%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:65.27913267614261%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:68.91377386263858%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:71.33712855648464%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:49.15850044960999%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:14.739731819534851%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:7.175836759582671%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:35.88033303601293%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:66.43640721083445%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:71.50667722915101%"></div><div class="flex-1 rounded-sm bg-foreground/20" style="height:65.21543807838687%"></div></div></div></div></div></div><div class="mt-8"><div class="flex flex-col lg:flex-row rounded-2xl border border-border shadow-sm"><div class="lg:w-[320px] shrink-0 bg-background border-b lg:border-b-0 lg:border-r border-border overflow-y-auto rounded-l-2xl"><div class="px-5 pt-6 pb-3"><h3 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Everything aviation in one API</h3></div><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-muted border-primary"><span><span class="block text-xl font-extrabold text-foreground">Airlines</span><span class="block text-xs text-muted-foreground mt-0.5">Profiles, fleet data, alliances &amp; branding</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Airports</span><span class="block text-xs text-muted-foreground mt-0.5">Traffic stats, coordinates &amp; logos</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Cities</span><span class="block text-xs text-muted-foreground mt-0.5">Population, timezone &amp; popularity score</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Countries &amp; Flags</span><span class="block text-xs text-muted-foreground mt-0.5">252 countries with flag images</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Routes</span><span class="block text-xs text-muted-foreground mt-0.5">38,000+ flight routes between airports</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Aircraft Types</span><span class="block text-xs text-muted-foreground mt-0.5">Specs, range &amp; fleet usage</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Route Maps</span><span class="block text-xs text-muted-foreground mt-0.5">SVG/PNG great-circle maps with airline logos</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Stats</span><span class="block text-xs text-muted-foreground mt-0.5">Airport &amp; airline network statistics in one call</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Aviation News</span><span class="block text-xs text-muted-foreground mt-0.5">AI-consolidated aviation news stories, updated hourly</span></span></button><button class="w-full text-left px-5 py-6 flex items-start transition-colors border-l-2 bg-background border-transparent hover:bg-muted/60 hover:border-border"><span><span class="block text-xl font-extrabold text-foreground">Carbon Emissions</span><span class="block text-xs text-muted-foreground mt-0.5">ICAO v13.1 CO₂ per passenger, all cabins, EU ETS offset</span></span></button></div><div class="flex-1 bg-[hsl(var(--hero-background))] flex flex-col rounded-r-2xl overflow-hidden"><div class="flex items-center justify-between px-5 pr-6 py-3 border-b border-white/10"><div class="flex items-center gap-2 text-slate-400 text-sm"><span class="font-mono">Airlines</span></div><button class="inline-flex items-center gap-1.5 text-sm font-medium text-foreground bg-white border border-gray-200 rounded-full px-3 py-1.5 shadow-sm hover:shadow-md transition-shadow whitespace-nowrap">More information <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-3.5 h-3.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button></div><div class="flex-1 overflow-auto relative"><div class="p-5"><pre class="text-sm font-mono leading-relaxed whitespace-pre"><span><span class="text-slate-500">// GET /v1/airlines</span>
</span><span><span class="text-slate-200"></span><span class="text-violet-400">const</span><span class="text-slate-200"> res = </span><span class="text-violet-400">await</span><span class="text-slate-200"> fetch(</span>
</span><span><span class="text-slate-200">  </span><span class="text-emerald-400">'https:&lt;comment&gt;//aviation-api.logostream.dev/v1/airlines?iata=LH'</span><span class="text-slate-200">,&lt;/comment&gt;</span>
</span><span><span class="text-slate-200">  { headers: { </span><span class="text-emerald-400">'x-api-key'</span><span class="text-slate-200">: </span><span class="text-emerald-400">'YOUR_KEY'</span><span class="text-slate-200"> } }</span>
</span><span><span class="text-slate-200">);</span>
</span><span><span class="text-slate-200"></span><span class="text-violet-400">const</span><span class="text-slate-200"> { data } = </span><span class="text-violet-400">await</span><span class="text-slate-200"> res.json();</span>
</span><span><span class="text-slate-200"></span>
</span><span><span class="text-slate-500">// data[0]</span>
</span><span><span class="text-slate-200">{</span>
</span><span><span class="text-slate-200">  iata: </span><span class="text-emerald-400">"LH"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  icao: </span><span class="text-emerald-400">"DLH"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  name: </span><span class="text-emerald-400">"Lufthansa"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  country_code: </span><span class="text-emerald-400">"DE"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  home_region: </span><span class="text-emerald-400">"Europe"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  alliance: </span><span class="text-emerald-400">"star_alliance"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  callsign: </span><span class="text-emerald-400">"LUFTHANSA"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  commenced_operations: </span><span class="text-emerald-400">"1955-04-01"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  active: </span><span class="text-violet-400">true</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  year_founded: 1953,</span>
</span><span><span class="text-slate-200">  base_airport_iata: </span><span class="text-emerald-400">"FRA"</span><span class="text-slate-200">,</span>
</span><span><span class="text-slate-200">  rating_skytrax_stars: 4,</span>
</span><span><span class="text-slate-200">  website: </span><span class="text-emerald-400">"https:&lt;comment&gt;//www.lufthansa.com"</span><span class="text-slate-200">,&lt;/comment&gt;</span>
</span><span><span class="text-slate-200">  colors: { primary: </span><span class="text-emerald-400">"#05164D"</span><span class="text-slate-200">, secondary: </span><span class="text-emerald-400">"#FFAD00"</span><span class="text-slate-200"> },</span>
</span><span><span class="text-slate-200">  logo: {</span>
</span><span><span class="text-slate-200">    icon: </span><span class="text-emerald-400">"https:&lt;comment&gt;//api.logostream.dev/airlines/icao/DLH?key=..."</span><span class="text-slate-200">,&lt;/comment&gt;</span>
</span><span><span class="text-slate-200">    logo: </span><span class="text-emerald-400">"https:&lt;comment&gt;//api.logostream.dev/airlines/icao/DLH?variant=logo&amp;key=..."</span><span class="text-slate-200">,&lt;/comment&gt;</span>
</span><span><span class="text-slate-200">    wordmark: </span><span class="text-emerald-400">"https:&lt;comment&gt;//api.logostream.dev/airlines/icao/DLH?variant=wordmark&amp;key=..."</span><span class="text-slate-200">&lt;/comment&gt;</span>
</span><span><span class="text-slate-200">  }</span>
</span><span><span class="text-slate-200">}</span>
</span></pre></div></div></div></div></div></div></section><section class="relative overflow-hidden py-36 bg-[hsl(var(--hero-background))]"><div class="absolute inset-0 pointer-events-none"><svg class="w-full h-full" viewBox="0 0 696 316" fill="none" preserveAspectRatio="xMidYMid slice"><path d="M-380 -189C-380 -189 -312 216 152 343C616 470 684 875 684 875" stroke="white" stroke-width="0.5" stroke-opacity="0.08" opacity="0.6" pathLength="1" stroke-dashoffset="0px" stroke-dasharray="0.3px 1px"></path><path d="M-375 -195C-375 -195 -307 210 147 337C611 464 679 869 679 869" stroke="white" stroke-width="0.53" stroke-opacity="0.095" opacity="0.6" pathLength="1" stroke-dashoffset="0px" stroke-dasharray="0.3px 1px"></path><path d="M-370 -201C-370 -201 -302 204 142 331C606 458 674 863 674 863" stroke="white" stroke-width="0.56" stroke-opacity="0.11" opacity="0.6" pathLength="1" stroke-dashoffset="0px" stroke-dasharray="0.3px 1px"></path><path d="M-365 -207C-365 -207 -297 198 137 325C601 452 669 857 669 857" stroke="white" stroke-width="0.59" stroke-opacity="0.125" opacity="0.6" pathLength="1" stroke-dashoffset="0px" stroke-dasharray="0.3px 1px"></path><path d="M-360 -213C-360 -213 -292 192 132 319C596 446 664 851 664 851" stroke="white" stroke-width="0.62" stroke-opacity="0.14" opacity="0.6" pathLength="1" stroke-dashoffset="0px" stroke-dasharray="0.3px 1px"></path><path d="M-355 -219C-355 -219 -287 186 127 313C591 440 659 845 659 845" stroke="white" stroke-width="0.65" stroke-opacity="0.155" opacity="0.6" pathLength="1" stroke-dashoffset="0px" stroke-dasharray="0.3px 1px"></path><path d="M-350 -225C-350 -225 -282 180 122 307C586 434 654 839 654 839" stroke="white" stroke-width="0.6799999999999999" stroke-opacity="0.16999999999999998" opacity="0.6" pathLength="1" stroke-dashoffset="0px" stroke-dasharray="0.3px 1px"></path><path d="M-345 -231C-345 -231 -277 174 117 301C581 428 649 833 649 833" stroke="white" stroke-width="0.71" stroke-opacity="0.185" opacity="0.6" pathLength=